# ─── Application ───────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailmind:mailmind_secret@localhost:5432/mailmind

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Pinecone ──────────────────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=mailmind

# ─── Tavily Web Search ─────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ─── LangSmith Observability ───────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=mailmind-capstone

# ─── Gmail OAuth2 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/email/gmail/callback

# ─── Microsoft / Outlook OAuth2 ────────────────────────────────
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_REDIRECT_URI=http://localhost:8000/email/outlook/callback

# ─── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
